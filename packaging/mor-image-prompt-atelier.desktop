[Desktop Entry]
Type=Application
Version=1.0
Name=Mor Image Prompt Atelier
GenericName=Image Prompt Editor
Comment=Write image prompts, save them with optional result images
Exec=mor-image-prompt-atelier
Icon=mor-image-prompt-atelier
Terminal=false
Categories=Graphics;
Keywords=prompt;image;ai;atelier;mor;
StartupNotify=true
# Match tao/wry binary class so the panel uses our hicolor icon while running.
StartupWMClass=mor-image-prompt-atelier
